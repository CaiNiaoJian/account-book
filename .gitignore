# =============================================================================
# AccountBook Desktop · 版本控制忽略规则
# -----------------------------------------------------------------------------
# 需求 14：本地数据库不上云。此文件是**数据隔离的第一道防线**，
# 任何属于「用户私有数据 / 运行时产物 / 密钥 / 构建输出」的内容都必须在此排除。
#
# 维护约定（务必遵守）：
#   1. 新增任何会把用户数据写入磁盘的目录，必须同步在本文件中排除。
#   2. 例外放行（!开头）必须写明理由，并且只放行「模板 / 示例 / 结构文件」。
#   3. 提交前可执行 `git status --ignored` 复核，确认 data/ 下没有任何内容被跟踪。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 用户数据（最关键的隔离区）—— 见 src/accountbook/paths.py 的目录布局
# -----------------------------------------------------------------------------
data/
**/data/
!docs/data/                     # 例外：文档中若出现 data 目录示例图，仍按文档管理

# 本地冒烟测试与截图验证产生的一次性目录
data-smoke/
data-test/
.smoke-test/
.edge-profile*/
.probe*

# SQLite 及其一切衍生文件（WAL / SHM / 日志 / 备份）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# 应用自有备份格式（需求：加密备份 .abk）
*.abk

# 附件、卡面、工资条、截图等用户上传资源
attachments/
cards/user/
payslips/
screenshots/
exports/
# 例外：docs/screenshots 是有意提交的界面截图（用于文档与验收留痕），
# 其中不得包含任何真实账目数据 —— 截图前请务必清空或使用示例数据。
!docs/screenshots/
!docs/screenshots/**

# 本地插件实例与插件私有数据（插件源码模板除外，见 plugins_sdk/）
plugins/
!src/accountbook/plugins_sdk/

# 机器学习模型与算法产物（P7+ 预留）
models/
*.joblib
*.pkl
*.onnx
*.pt
*.h5

# -----------------------------------------------------------------------------
# 2. 导入 / 导出样本（可能含真实账单，绝不入库）
# -----------------------------------------------------------------------------
# 只允许 tests/fixtures 下的脱敏测试样本
*.csv
*.xlsx
*.xls
*.ofx
*.qfx
*.qif
!tests/fixtures/**
!docs/**/*.csv
!docs/**/*.xlsx

# -----------------------------------------------------------------------------
# 3. 日志与崩溃转储
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
crash-*.dmp
crash-*.txt

# -----------------------------------------------------------------------------
# 4. 密钥、凭证、本地配置（AI Key 等）
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json
credentials.json
config.local.json
*.key
*.pem
*.p12
*.pfx

# -----------------------------------------------------------------------------
# 5. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.venv*/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
pytest-of-*/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# 本地 pip / npm 缓存（为绕开沙箱外写入而落在工作区内）
.pip-cache/
.npm-cache/

# -----------------------------------------------------------------------------
# 6. Node / 前端
# -----------------------------------------------------------------------------
node_modules/
web/dist/
web/.vite/
web/stats.html
*.tsbuildinfo
.eslintcache

# 前端构建产物：由 packaging/build_frontend.ps1 生成（vite build 会清空该目录），
# 属于可重建的构建输出，**不纳入版本库**。
# 从克隆仓库开始工作的第一步就是执行该脚本（见 README「快速开始」）。
src/accountbook/resources/web_dist/

# -----------------------------------------------------------------------------
# 7. 打包与分发产物
# -----------------------------------------------------------------------------
dist/
release/
out/
*.spec.bak
AccountBook-*.zip
AccountBook-Setup-*.exe
SHA256SUMS.txt
installer-output/

# -----------------------------------------------------------------------------
# 8. 编辑器 / 操作系统
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# 9. 本地产物标记
# -----------------------------------------------------------------------------
portable.flag                    # 便携模式标记由打包脚本生成，不入库
*.local
*.bak
*.tmp
